<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Time_Tacking</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>ico\TimeTracking-Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="ico\TimeTracking-Icon.ico" />
    <Content Include="ico\TimeTracking-Icon2.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Datos\Esquema.sql" LogicalName="Esquema.sql" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="web\" />
  </ItemGroup>

	<ItemGroup>
		<None Update="web\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>Time_Tacking</RootNamespace>
		<AssemblyName>Time Tracking</AssemblyName>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>ico\TimeTracking-Icon.ico</ApplicationIcon>
		
		<!-- Información de ensamblado -->
		<AssemblyTitle>Time Tracking</AssemblyTitle>
		<Description>Aplicación para el control de tiempos por proyecto.</Description>
		<Company>Eduardo Marmolejo Ornelas</Company>
		<Product>Time Tracking</Product>
		<Copyright>Copyright © 2026 Time Tracking</Copyright>
		<Trademark></Trademark>

		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<InformationalVersion>1.0.0</InformationalVersion>
		
	</PropertyGroup>

</Project>